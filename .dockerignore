# Docker build context exclusions for Ferroma.

# Build environment that only exists on the development machine. `.cargo/config.toml`
# points at a local crates.io proxy; the container must use the real registry.
.cargo/
.cargo-home/
.cache/
.probe/
target/
target-*/

# Repository metadata
.git/
.gitignore
.github/
.arts/
.codeartsdoer/

# Local state that must never leak into an image
data/
var/
*.log
.env
.env.local
*.pem
*.key
!tests/fixtures/**/*.pem

# Docs and tooling are not needed to build or run
docs/
tools/
**/*.md
!README.md
tests/
scripts/
