# =============================================================================
# Ferroma — environment file
# =============================================================================
#   cp .env.example .env
#
# `.env` is read by docker-compose and is gitignored. Never commit real secrets.
#
# Deploying onto a server that already runs PostgreSQL? Do not copy this file by
# hand — `./scripts/deploy.sh` asks the questions, generates the secrets, creates
# the role and database, and writes `.env` for you. The variables it sets are at
# the bottom of this file, under "Existing PostgreSQL".
#
# Any Ferroma setting can be overridden from the environment:
#     FERROMA__SMTP__PORT=2525          (double underscore = path separator)
#     FERROMA__TLS__ENABLED=true
# The shorthands below are the ones operators actually type.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=ferroma
# REQUIRED. Generate one:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=ferroma

# -----------------------------------------------------------------------------
# Identity
# -----------------------------------------------------------------------------
# The FQDN this server calls itself. It appears in the SMTP banner, in `Received:`
# headers and in generated `Message-ID`s, and it MUST match the PTR record of your
# public IP or large providers will junk your mail.
FERROMA_HOSTNAME=mail.example.com

# Externally reachable base URL, used in `.well-known/ferroma` autodiscovery and
# in links inside notification mail.
FERROMA_PUBLIC_URL=https://mail.example.com

FERROMA_LOG_LEVEL=info
# "text" for humans, "json" when shipping to Loki/ELK.
FERROMA_LOG_FORMAT=text

# -----------------------------------------------------------------------------
# Secrets
# -----------------------------------------------------------------------------
# REQUIRED. Signs access and refresh tokens. Without it, every session is
# invalidated on restart.
#   openssl rand -base64 48
FERROMA_JWT_SECRET=change-me-jwt-secret

# -----------------------------------------------------------------------------
# TLS
# -----------------------------------------------------------------------------
# Terminate SMTP and IMAP TLS inside Ferroma (465/993) instead of leaving it to a
# reverse proxy. Requires the certificate files to be mounted into the container.
# There is no HTTPS listener — Webmail/Admin/API HTTPS belongs to a proxy.
FERROMA_TLS_ENABLED=false
# FERROMA_TLS_CERT=/etc/ferroma/tls/fullchain.pem
# FERROMA_TLS_KEY=/etc/ferroma/tls/privkey.pem
# The implicit-TLS listeners are 0 (off) in the shipped default, so these two are
# what actually create 465 and 993 once TLS is enabled:
# FERROMA__SMTP__SMTPS_PORT=465
# FERROMA__IMAP__IMAPS_PORT=993

# -----------------------------------------------------------------------------
# Published ports
# -----------------------------------------------------------------------------
SMTP_PORT=25
SUBMISSION_PORT=587
IMAP_PORT=143
HTTP_PORT=8080

# -----------------------------------------------------------------------------
# Outbound sender authentication (strongly recommended for deliverability)
# -----------------------------------------------------------------------------
# Generate a key, publish the TXT record the Admin panel shows, then enable:
#   docker compose exec ferroma ferroma dkim generate --domain example.com
FERROMA_DKIM_ENABLED=false
FERROMA_DKIM_SELECTOR=default
# FERROMA_DKIM_KEY=/etc/ferroma/dkim/default.private

# -----------------------------------------------------------------------------
# Image
# -----------------------------------------------------------------------------
# Two different jobs, depending on which compose file reads it.
#
#   docker-compose.yml (development)  builds the tree and tags the result with this
#       value. It pins `pull_policy: build`, so the name is only a local label and is
#       never pulled — which is why `dev` is right here: it is not a published tag,
#       and if it were, `up` would run the release instead of your source.
#   docker-compose.prod.yml / docker-compose.external-db.yml  pull instead of
#       building, so this must be a *released* tag (0.1.3, or latest to try it out).
#       Leaving `dev` in place makes them fail at pull time, because no such tag
#       exists upstream.
FERROMA_VERSION=dev

# Repository the image comes from — Docker Hub by default, but any registry works.
# Releases are published as `wesukilaye/ferroma` for linux/amd64 and linux/arm64:
#   docker pull wesukilaye/ferroma:0.1.9
# Tags: `X.Y.Z` for one release and `latest` for the newest one — nothing else. There
# is deliberately no rolling `X.Y` tag (a patch release must not silently move a tag an
# operator pinned) and no `buildcache` tag. Pin the exact release in production;
# `latest` is for trying it out.
# FERROMA_REPO=wesukilaye/ferroma

# =============================================================================
# Existing PostgreSQL + reverse proxy (docker-compose.external-db.yml)
# =============================================================================
# Everything below is written by `scripts/deploy.sh`; it is listed here so that a
# `.env` produced by it is readable, and so that it can be edited by hand later.
# Settings changed by hand take effect on `docker compose up -d`.
#
# The stack uses `network_mode: host`, so the host's PostgreSQL is simply
# 127.0.0.1 from inside the container — no `listen_addresses`, no `pg_hba.conf`
# change for a Docker subnet, no host-gateway.
#
# DATABASE_URL=postgres://ferroma:PASSWORD@127.0.0.1:5432/ferroma
# DB_HOST=127.0.0.1
# DB_PORT=5432
#
# The PostgreSQL client image deploy.sh pulls for its schema checks — used only
# when the host has no `psql` of its own. deploy.sh detects the server's major
# version and sets it. It is a client image: no database server is ever started.
# POSTGRES_IMAGE=postgres:16-alpine
#
# A tag containing "/" is pulled from a registry; anything else is built here.
# FERROMA_IMAGE=wesukilaye/ferroma:0.1.9
#
# Plaintext HTTP API. It is bound to loopback on purpose: the reverse proxy is
# the only client, and `trust_proxy_headers` is only safe that way. When the proxy
# runs in a *container* it cannot see the host's loopback address — bind this to
# the host's Docker bridge address instead (usually 172.17.0.1) and point the proxy
# there. See docs/deployment.md §5.4.
# FERROMA_API_HOST=127.0.0.1
# FERROMA_API_PORT=18080
#
# The publicly reachable base URL: what `.well-known/ferroma` advertises and what
# links in notification mail point at. Keep the key name — the compose files spell
# it as FERROMA_API_PUBLIC_URL for the server, which is the name it reads — and
# omit the port when the proxy serves the hostname on 443.
# FERROMA_PUBLIC_URL=https://mail.example.com
#
# The HTTPS port the proxy serves the mail hostname on. Anything but 443 goes into
# FERROMA_PUBLIC_URL, and costs client autodiscovery and MTA-STS (both are defined
# to live on 443). Leave it at 443 unless the proxy cannot have that port.
# FERROMA_PUBLIC_PORT=443
# FERROMA__API__TRUST_PROXY_HEADERS=true
# FERROMA__API__SECURE_COOKIES=true
#
# Where the two front-ends and the modules they share live. The container image
# sets all three itself; a deployment that mounts the apps elsewhere sets them
# here. `shared_dir` is the directory both apps import as `../shared/…`.
# FERROMA__API__WEBMAIL_DIR=/usr/share/ferroma/web
# FERROMA__API__ADMIN_DIR=/usr/share/ferroma/admin
# FERROMA__API__SHARED_DIR=/usr/share/ferroma/shared
#
# Implicit-TLS listeners. Both are 0 (off) in the shipped default, so 465 and
# 993 exist only once these are set — alongside FERROMA_TLS_ENABLED/CERT/KEY.
# FERROMA__SMTP__SMTPS_PORT=465
# FERROMA__IMAP__IMAPS_PORT=993
#
# The DKIM private key lives inside the data volume, where the container writes
# it as uid 10001 — so a backup of that volume carries it. Losing the key
# invalidates every DKIM signature this host has made.
# FERROMA_DKIM_SELECTOR=default
# FERROMA_DKIM_KEY=/var/lib/ferroma/dkim/default.private
# FERROMA_DKIM_ENABLED=false
#
# Outbound relay ("smarthost"). Set these when this host's public IP has no PTR
# record — or its provider will not set one — because mail from such an IP is
# junked by Gmail and refused by Microsoft's properties. Receiving is unaffected;
# only outbound needs the relay. Everything else still resolves MX directly, so
# `FERROMA__QUEUE__RELAY_FROM_DOMAINS` can limit the relay to the domains you
# actually send as. See docs/smtp.md §11.4.
# FERROMA_RELAY_HOST=smtp.example-relay.com
# FERROMA_RELAY_PORT=587
# FERROMA_RELAY_TLS=starttls          # starttls | implicit (465) | none (internal)
# FERROMA_RELAY_USERNAME=…
# FERROMA_RELAY_PASSWORD=…
# FERROMA__QUEUE__RELAY_FROM_DOMAINS=["example.com"]   # empty/absent = everything
#
# Backups are the host's job: this deployment ships no backup service. Dump the
# database and copy the ferroma-data volume together — docs/deployment.md §8.
#
# Bookkeeping for scripts/deploy.sh (ignored by the server).
# FERROMA_DEPLOY_DOMAIN=example.com
# FERROMA_DEPLOY_ADMIN=admin@example.com
# FERROMA_DEPLOY_SETUP_DONE=0
